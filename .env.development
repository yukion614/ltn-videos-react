# 開發用。npm run dev 時 Next 會自動讀這份（正式建置不會讀）。

# 資料 API 的 host
NEXT_PUBLIC_API_BASE=https://data.ltn.com.tw/brand/api

# 站台環境。不是 production 的話，robots.txt 會整站禁止索引（見 app/robots.ts）
NEXT_PUBLIC_SITE_ENV=development

# 後端還沒好的 API 是否改回假資料（見 app/_mocks/setupMock.ts）。
# 只影響有註冊 mock 的路徑（目前只有 /live），其餘照打真的 API。
NEXT_PUBLIC_API_MOCK=true

#測試用
NEXT_PUBLIC_HOME_PLAYLIST_PATH=/playlist-list/home2
NEXT_PUBLIC_TOPIC_PLAYLIST_PATH=/playlist-list/topic2
