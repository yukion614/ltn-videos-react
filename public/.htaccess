# LTN 影音 — 靜態站 SPA fallback（Apache）
#
# 背景：專案以 output:"export" 產生純靜態檔到 out/，部分頁面不預先產生，
# 靠伺服器把「找不到檔案」的網址改寫回對應的外殼頁（回 200，非 302），
# 由外殼頁讀網址參數即時抓 API 渲染，免重 build 也不會 404。
#
# 對應關係（與 deploy/nginx.conf 的 location 規則一致）：
#   /programs/{key}          -> /programs/_shell/index.html   （分類頁外殼）
#   /programs/{key}/video/*  -> /video-fallback/index.html    （影片詳細頁外殼）
#   /topic/video/*           -> /video-fallback/index.html
#   /shorts/{id}             -> /shorts/index.html            （短影音單則外殼）
#
# 部署前提：Apache 需載入 mod_rewrite，且此目錄的 AllowOverride 至少含 FileInfo
# （或直接把下列規則貼進 vhost 的 <Directory> 區塊）。
#
# Next.js（output:"export"）會把 public/ 的檔案複製到 out/ 根目錄，
# 因此本檔隨每次 build 一起輸出、隨靜態站一起部署，不必手動上傳。

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 實體檔案或資料夾存在時，正常服務，不套用任何 fallback
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 影片詳細頁 SPA fallback：/programs/{key}/video/*、/topic/video/*
  RewriteRule ^(programs/[^/]+/video|topic/video)/ /video-fallback/index.html [L]

  # 短影音單則 SPA fallback：/shorts/{id}
  RewriteRule ^shorts/[^/]+/?$ /shorts/index.html [L]

  # 節目分類頁 SPA fallback：/programs/{key}（單層，結尾即 key）
  RewriteRule ^programs/[^/]+/?$ /programs/_shell/index.html [L]
</IfModule>
