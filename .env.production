# 正式用。npm run build / npm run start 時 Next 會自動讀這份（開發不會讀）。
# 部署方讀的是這份的值。

# 資料 API 的 host
NEXT_PUBLIC_API_BASE=https://data.ltn.com.tw/brand/api

# 站台環境。production 才會開放搜尋引擎索引（見 app/robots.ts）
NEXT_PUBLIC_SITE_ENV=production

#測試用
NEXT_PUBLIC_HOME_PLAYLIST_PATH=/playlist-list/home2
NEXT_PUBLIC_TOPIC_PLAYLIST_PATH=/playlist-list/topic2
